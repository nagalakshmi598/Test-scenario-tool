# QA Test Scenario Tool — configuration template
#
# Copy this file to .env in the same folder and fill in the values you need:
#
#     copy .env.sample .env
#
# .env is gitignored and holds live secrets — never commit it or paste it
# into a chat. This file is the committed template and must stay free of
# real keys.
#
# Nothing here is required to start the tool. It runs with no configuration
# at all, storing data in server/data/db.json.


# ---------- AI (optional) ----------
# Needed for the Test Cases button and for the assistant to draft scenarios
# for a feature. Everything else — uploading, editing, search, counts,
# pass/fail — works without a key.
#
# Set ONE of these. If both are present OpenAI is used unless AI_PROVIDER
# says otherwise.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# optional; any chat model the account can use. Default: gpt-4o
# gpt-4o gives noticeably better scenarios than gpt-4o-mini.
OPENAI_MODEL=

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# optional. Default: claude-opus-5
ANTHROPIC_MODEL=

# Force one provider when both keys are set: openai | anthropic
AI_PROVIDER=


# ---------- Database (optional) ----------
# Leave MONGODB_URI empty and the tool stores everything in
# server/data/db.json — no install, no account, single machine.
#
# Set it and the tool uses MongoDB instead, which is what you want once more
# than one person shares an instance. Move existing data across with:
#
#     node server/migrate.js
#
# Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Local server: mongodb://127.0.0.1:27017
#
# If the password contains @ : / ? # % it must be URL-encoded
# (@ becomes %40, # becomes %23), or the connection string will not parse.
MONGODB_URI=

# Optional. Defaults to the database named in the URI, else cf_test_scenarios
MONGODB_DB=cf_test_scenarios


# ---------- Server ----------
# Optional. Defaults to 4310
PORT=
